{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "musiclib",
  "main": "./share-worker.js",
  "compatibility_date": "2026-06-11",
  "observability": {
    "enabled": true
  },
  // 原版直接把 musiclib/ 整个目录当静态资产发布；React 版的可发布产物是 vite build 的输出。
  // 部署前必须先 npm run build，否则发上去的是空目录。
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/s/*"],
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
